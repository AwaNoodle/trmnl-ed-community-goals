{% assign goal = activeInitiatives | first %}
{% assign active_goal_count = activeInitiatives | size %}

{% template goal_progress %}
  {% assign target = goal.target_qty | plus: 0 %}
  {% assign progress = 0 %}
  {% if target > 0 %}
    {% assign progress = goal.qty | times: 100.0 | divided_by: target | round: 2 %}
  {% endif %}
  {% assign progress_fill = progress | at_most: 100 %}
  <div class="progress-bar {{ size_class }} progress-bar--emphasis-3">
    <div class="content">
      <span class="label">Goal Progress</span>
      <span class="value value--xxsmall">{{ progress }} %</span>
    </div>
    <div class="track">
      <div class="fill" style="width: {{ progress_fill }}%"></div>
    </div>
  </div>
{% endtemplate %}

{% template goal_summary %}
  <div class="flex flex--col flex--stretch-x flex--between gap">
    <span class="title lg:title--large" data-clamp="2">{{ goal.title }}</span>
    {% render "goal_progress", goal: goal, size_class: "progress-bar--large" %}
  </div>
{% endtemplate %}

{% template no_goal %}
  <div class="layout layout--col layout--center">
    <span class="title {{ title_class }}">No active community goal</span>
    <span class="description">Waiting for the next initiative</span>
  </div>
{% endtemplate %}

{% template goal_title_bar %}
  {%- capture icon_svg -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 32 32" fill="none" stroke="black" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 4.5 L27 25 L16 20.5 L5 25 Z"/>
      <path d="M11.5 16 L14.5 19 L19 13.5"/>
    </svg>
  {%- endcapture -%}
  <div class="title_bar">
    <img class="image" src="data:image/svg+xml;base64,{{ icon_svg | base64_encode }}" alt="">
    <span class="title">{{ instance_name }}</span>
    <span class="instance">{{ active_goal_count }} Active Goal{% if active_goal_count != 1 %}s{% endif %}</span>
  </div>
{% endtemplate %}
