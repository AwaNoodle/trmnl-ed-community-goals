{% if goal %}
  <div class="layout layout--col layout--stretch-x">
    <div class="flex flex--row gap grow basis--0">
      <div class="flex flex--col flex--center-y w--[42cqw] shrink-0">
        {% render "goal_percent", goal: goal, size_class: "value--xxlarge portrait:value--xlarge lg:value--xxxlarge lg:portrait:value--xxlarge" %}
      </div>
      <div class="flex flex--col flex--left flex--center-y gap--small grow basis--0">
        <span class="title title--small lg:title--base" data-clamp="3">{{ goal.title }}</span>
        <span class="label label--small lg:label--large">Ends {{ goal.expiry | date: "%Y-%m-%d" }}</span>
      </div>
    </div>
  </div>
{% else %}
  {% render "no_goal", title_class: "title--small" %}
{% endif %}
{% render "goal_title_bar", instance_name: trmnl.plugin_settings.instance_name, active_goal_count: active_goal_count %}
