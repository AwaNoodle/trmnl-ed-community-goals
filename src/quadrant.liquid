{% if goal %}
  <div class="layout layout--col layout--stretch gap">
    <span class="title title--small lg:label--large" data-clamp="2">{{ goal.title }}</span>
    {% render "goal_progress", goal: goal, size_class: "progress-bar--small lg:progress-bar--large" %}
    <span class="label label--small lg:title--base">Ends {{ goal.expiry | date: "%Y-%m-%d" }}</span>
  </div>
{% else %}
  {% render "no_goal", title_class: "title--small" %}
{% endif %}
{% render "goal_title_bar", instance_name: trmnl.plugin_settings.instance_name, active_goal_count: active_goal_count %}
