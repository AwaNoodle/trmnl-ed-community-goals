{% if goal %}
  <div class="layout layout--col layout--stretch-x">
    <div class="flex flex--col flex--stretch-x gap grow basis--0">
      <span class="title lg:title--large" data-clamp="2">{{ goal.title }}</span>
      <span class="description description--large lg:description--xxlarge" data-clamp="9" data-clamp-portrait="23" data-clamp-lg="16" data-clamp-lg-portrait="24">{{ goal.bulletin }}</span>
    </div>
    <div class="flex flex--col flex--stretch-x gap">
      <div class="divider"></div>
      {% render "goal_progress", progress: progress, progress_fill: progress_fill, size_class: "progress-bar--large" %}
      <table class="table" data-table-limit="true">
        <thead>
          <tr>
            <th class="w--[16cqw] portrait:w--[24cqw]"><span class="title">End Date</span></th>
            <th class="w--[11cqw] portrait:w--auto"><span class="title">System</span></th>
            <th class="w--[14cqw] portrait:w--auto"><span class="title">Station</span></th>
            <th><span class="title">Objective</span></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="label">{{ goal.expiry | date: "%Y-%m-%d" }}</span></td>
            <td><span class="label">{{ goal.starsystem_name }}</span></td>
            <td><span class="label">{{ goal.market_name }}</span></td>
            <td><span class="label">{{ goal.objective }}</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
{% else %}
  {% render "no_goal", title_class: "" %}
{% endif %}
{% render "goal_title_bar", instance_name: trmnl.plugin_settings.instance_name, active_goal_count: active_goal_count %}
