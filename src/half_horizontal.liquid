{% if goal %}
  <div class="layout layout--col layout--stretch-x">
    <div class="flex flex--row flex--stretch-y gap--large grow basis--0">
      <div class="flex flex--col flex--center-y w--[26cqw] shrink-0">
        {% render "goal_percent", goal: goal, size_class: "value--xxxlarge portrait:value--xxlarge lg:value--giga lg:portrait:value--xxxlarge" %}
        <span class="label lg:label--large">Complete</span>
      </div>
      <div class="divider--v"></div>
      <div class="flex flex--col flex--stretch-x flex--center-y gap grow basis--0">
        <span class="title lg:title--large" data-clamp="2">{{ goal.title }}</span>
        {% render "goal_facts", goal: goal %}
      </div>
    </div>
  </div>
{% else %}
  {% render "no_goal", title_class: "title--small" %}
{% endif %}
{% render "goal_title_bar", instance_name: trmnl.plugin_settings.instance_name, active_goal_count: active_goal_count %}
