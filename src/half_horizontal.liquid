{% if goal %}
  <div class="layout layout--col layout--stretch gap">
    <span class="title title--small" data-clamp="1">{{ goal.title }}</span>
    {% render "goal_progress", progress: progress, progress_fill: progress_fill, size_class: "" %}
    <table class="table table--small" data-table-limit="true">
      <thead>
        <tr>
          <th class="w--[41cqw] portrait:w--auto"><span class="title">End Date</span></th>
          <th class="w--[26cqw] portrait:w--auto"><span class="title">System</span></th>
          <th class="w--[33cqw] portrait:w--auto"><span class="title">Station</span></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="label">{{ goal.expiry | date: "%Y-%m-%d" }}</span></td>
          <td><span class="label">{{ goal.starsystem_name }}</span></td>
          <td><span class="label">{{ goal.market_name }}</span></td>
        </tr>
      </tbody>
    </table>
  </div>
{% else %}
  {% render "no_goal", title_class: "title--small" %}
{% endif %}
{% render "goal_title_bar", instance_name: trmnl.plugin_settings.instance_name, active_goal_count: active_goal_count %}
