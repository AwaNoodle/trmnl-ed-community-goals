{% if goal %}
  <div class="layout layout--col layout--stretch-x">
    <div class="flex flex--col flex--stretch-x gap grow basis--0">
      <span class="title title--small lg:title--base" data-clamp="2">{{ goal.title }}</span>
      <span class="description description--large lg:description--xxlarge" data-clamp="10" data-clamp-portrait="24" data-clamp-lg="20" data-clamp-lg-portrait="29">{{ goal.bulletin }}</span>
    </div>
    <div class="flex flex--col flex--stretch-x gap">
      <div class="divider"></div>
      {% render "goal_progress", goal: goal, size_class: "" %}
      <table class="table table--small" data-table-limit="true">
        <tbody>
          <tr>
            <td><span class="label">End Date</span></td>
            <td><span class="label">{{ goal.expiry | date: "%Y-%m-%d" }}</span></td>
          </tr>
          <tr>
            <td><span class="label">System</span></td>
            <td><span class="label">{{ goal.starsystem_name }}</span></td>
          </tr>
          <tr>
            <td><span class="label">Station</span></td>
            <td><span class="label">{{ goal.market_name }}</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
{% else %}
  {% render "no_goal", title_class: "title--small" %}
{% endif %}
{% render "goal_title_bar", instance_name: trmnl.plugin_settings.instance_name, active_goal_count: active_goal_count %}
