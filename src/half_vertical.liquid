{% if goal %}
  <div class="layout layout--col layout--stretch-x gap">
    <div class="flex flex--col">
      {% render "goal_percent", goal: goal, size_class: "value--xxxlarge lg:value--giga" %}
      <span class="label lg:label--large">Complete</span>
    </div>
    <div class="divider"></div>
    <span class="title title--small lg:title--base" data-clamp="2">{{ goal.title }}</span>
    <div class="flex flex--col grow basis--0">
      <span class="description lg:description--large" data-clamp="8" data-clamp-portrait="18" data-clamp-lg="10" data-clamp-lg-portrait="20">{{ goal.bulletin }}</span>
    </div>
    {% render "goal_facts", goal: goal %}
  </div>
{% else %}
  {% render "no_goal", title_class: "title--small" %}
{% endif %}
{% render "goal_title_bar", instance_name: trmnl.plugin_settings.instance_name, active_goal_count: active_goal_count %}
